%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ffa302fe71f764f4f8464c345ab9ca1c, type: 3}
  m_Name: TutorialLanguageTable
  m_EditorClassIdentifier: Assembly-CSharp::LanguageTable
  entries:
  - key: tutorial.intro.welcome
    japanese: "CuratorJack\u3078\u3088\u3046\u3053\u305D\uFF01\n\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u3084\u3063\u3066\u307F\u3088\u3046\uFF01"
    english: 'Welcome to CuratorJack!

      Let''s try the tutorial!'
  - key: tutorial.click_hint
    japanese: "\u30AF\u30EA\u30C3\u30AF\u3067\u6B21\u3078"
    english: Click to continue
  - key: tutorial.seller.open_hand
    japanese: "\u307E\u305A\u306F\u51FA\u54C1\u8005\u30BF\u30FC\u30F3\uFF01\n\u307E\u305A\u306F\u81EA\u5206\u306E\u30AB\u30FC\u30C9\u3092\u898B\u3066\u307F\u3088\u3046\uFF01"
    english: 'First up is the seller''s turn!

      Let''s start by looking at your
      cards!'
  - key: tutorial.seller.look_goods
    japanese: "\u51FA\u54C1\u30AB\u30FC\u30C9\u3092\u898B\u3066\u307F\u3088\u3046\uFF01"
    english: Let's look at a listing card!
  - key: tutorial.seller.card_detail
    japanese: "\u3053\u306E\u3088\u3046\u306B\u30AB\u30FC\u30C9\u306E\u8A73\u7D30\u3092\n\u898B\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3088\uFF01"
    english: 'This is how you can see

      a card''s details!'
  - key: tutorial.seller.select_goods
    japanese: "\u30AB\u30FC\u30C9\u3092\u9078\u629E\u3057\u3066\u307F\u3088\u3046\uFF01"
    english: Let's select the card!
  - key: tutorial.seller.attach_buff
    japanese: "\u6B21\u306F\u30A8\u30D5\u30A7\u30AF\u30C8\u30AB\u30FC\u30C9\u3092\u3064\u3051\u3066\u307F\u3088\u3046\uFF01"
    english: Next, let's attach an effect card!
  - key: tutorial.seller.raise
    japanese: "\u30A8\u30D5\u30A7\u30AF\u30C8\u30AB\u30FC\u30C9\u304C\u3064\u3044\u3066\u3044\u308B\u51FA\u54C1\u306B\u306F\n\u4ED8\u52A0\u4FA1\u5024\u3092\u3064\u3051\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3088\uFF01"
    english: 'Listings with effect cards

      can be given added value!'
  - key: tutorial.seller.attach_debuff
    japanese: "\u30A8\u30D5\u30A7\u30AF\u30C8\u30AB\u30FC\u30C9\u306F\u51FA\u54C1\u30AB\u30FC\u30C9\u306B\n\u4F55\u679A\u3067\u3082\u3064\u3051\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3088\uFF01"
    english: 'You can attach as many effect cards

      as you like to a listing
      card!'
  - key: tutorial.seller.confirm
    japanese: "\u78BA\u5B9A\u3092\u62BC\u3057\u3066\u51FA\u54C1\u3057\u3066\u307F\u3088\u3046\uFF01"
    english: Press confirm to list it!
  - key: tutorial.auction.intro
    japanese: "\u30AA\u30FC\u30AF\u30B7\u30E7\u30F3\u958B\u59CB\uFF01\u51FA\u54C1\u8005\u4EE5\u5916\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\n\u5165\u672D\u3059\u308B\u304B\u964D\u308A\u308B\u304B\u3092\u9078\u3076\u3088\uFF01"
    english: 'The auction begins! Everyone except the seller

      chooses to bid
      or fold!'
  - key: tutorial.auction.sold
    japanese: "\u76F8\u624B\u304C\u843D\u672D\u3057\u305F\u306E\u3067\u3001\u4ED8\u3051\u305F\u30A8\u30D5\u30A7\u30AF\u30C8\u30AB\u30FC\u30C9\u306F\n\u843D\u672D\u3057\u305F\u30D7\u30EC\u30A4\u30E4\u30FC\u306B\u767A\u52D5\u3059\u308B\u3088\uFF01"
    english: 'An opponent won the auction, so the attached

      effect cards take
      effect on the winner!'
  - key: tutorial.auction.unsold
    japanese: "\u3082\u3057\u8AB0\u3082\u843D\u672D\u3057\u306A\u304B\u3063\u305F\u3068\u304D\u306F\u3001\u30A8\u30D5\u30A7\u30AF\u30C8\u30AB\u30FC\u30C9\u306F\n\u51FA\u54C1\u8005\u306E\u81EA\u5206\u306B\u767A\u52D5\u3059\u308B\u3088\uFF01"
    english: 'If nobody wins the auction, the effect cards

      take effect on
      you, the seller!'
  - key: tutorial.auction.fold
    japanese: "\u964D\u308A\u305F\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u898B\u9001\u308A\u6A29\u30921\u679A\u4F7F\u3046\u3088\uFF01\n\u673A\u306E\u4E0A\u306E\u30C1\u30B1\u30C3\u30C8\u306E\u679A\u6570\u304C\u4ECA\u306E\u898B\u9001\u308A\u6A29\uFF08HP\uFF09\uFF01\n\u898B\u9001\u308A\u6A29\u304C0\u679A\u306E\u3068\u304D\u306B\u964D\u308A\u308B\u3068\u8131\u843D\uFF01"
    english: 'Players who fold use up one pass!

      The tickets on the desk show
      the passes (HP) left.

      Folding with zero passes knocks you out!'
  - key: tutorial.info.open
    japanese: "\u30A4\u30F3\u30D5\u30A9\u30E1\u30FC\u30B7\u30E7\u30F3\u30DE\u30FC\u30AF\u3092\u62BC\u3059\u3068\u3001\n\u30AB\u30FC\u30C9\u306E\u4E00\u89A7\u304C\u898B\u3089\u308C\u308B\u3088\uFF01\u62BC\u3057\u3066\u307F\u3088\u3046\uFF01"
    english: 'Press the information mark

      to see the list of cards! Give it
      a try!'
  - key: tutorial.info.catalog
    japanese: "\u4E0A\u306E\u30BF\u30D6\u3067\u5546\u54C1\u30FB\u30A8\u30D5\u30A7\u30AF\u30C8\u30FB\u30B9\u30DA\u30B7\u30E3\u30EB\u3092\u5207\u308A\u66FF\u3048\u3089\u308C\u308B\u3088\uFF01\n\u30A6\u30A3\u30F3\u30C9\u30A6\u306E\u5916\u3092\u62BC\u3059\u3068\u9589\u3058\u308B\u3088\uFF01"
    english: 'Use the tabs at the top to switch between goods, effects and specials!

      Click
      outside the window to close it!'
  - key: tutorial.inspect.open
    japanese: "\u866B\u773C\u93E1\u30DE\u30FC\u30AF\u3092\u62BC\u3059\u3068\u3001\u305D\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\n\u624B\u5143\u3092\u8FD1\u304F\u3067\u898B\u3089\u308C\u308B\u3088\uFF01\u62BC\u3057\u3066\u307F\u3088\u3046\uFF01"
    english: 'Press a magnifier mark to take a closer look

      at that player''s
      spot!'
  - key: tutorial.inspect.view
    japanese: "\u30C1\u30B1\u30C3\u30C8\u306E\u679A\u6570\u304C\u305D\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u898B\u9001\u308A\u6A29\uFF08HP\uFF09\u3001\n\u7A4D\u307E\u308C\u3066\u3044\u308B\u30AB\u30FC\u30C9\u304C\u843D\u672D\u3057\u305F\u30AB\u30FC\u30C9\u3060\u3088\uFF01"
    english: 'The tickets are that player''s passes (HP),

      and the stacked
      cards are the cards they won!'
  - key: tutorial.bid.intro
    japanese: "\u4ECA\u5EA6\u306F\u5165\u672D\u3057\u3066\u307F\u3088\u3046\uFF01W/S
      \u304B \u2191/\u2193 \u3067\u91D1\u984D\u3092\u6C7A\u3081\u3066\u3001\n\u5165\u672D\u30DC\u30BF\u30F3\u3092\u62BC\u305D\u3046\uFF01"
    english: "Now let's try bidding! Set the amount with W/S or \u2191/\u2193,\nthen
      press the bid button!"
  - key: tutorial.fold.leader
    japanese: "\u4ECA\u306F\u81EA\u5206\u304C\u6700\u9AD8\u984D\uFF01\n\u6700\u9AD8\u984D\u306E\u3042\u3044\u3060\u306F\u964D\u308A\u3089\u308C\u306A\u3044\u3088\uFF01"
    english: 'You''re the highest bidder now!

      You can''t fold while you hold
      the highest bid!'
  - key: tutorial.bid.raise
    japanese: "\u4E0A\u56DE\u3089\u308C\u305F\uFF01\n\u91D1\u984D\u3092\u4E0A\u3052\u3066\u5165\u672D\u3057\u8FD4\u305D\u3046\uFF01"
    english: 'You''ve been outbid!

      Raise the amount and bid back!'
  - key: tutorial.fold.outbid
    japanese: "\u5024\u6BB5\u304C\u3069\u3093\u3069\u3093\u4E0A\u304C\u3063\u3066\u304D\u305F\uFF01\n\u3053\u308C\u4EE5\u4E0A\u306F\u9AD8\u3059\u304E\u308B\u306E\u3067\u964D\u308A\u3088\u3046\u3002\u964D\u308A\u308B\u30DC\u30BF\u30F3\u3092\u62BC\u305D\u3046\uFF01\n\uFF08\u898B\u9001\u308A\u6A29\u30921\u679A\u4F7F\u3046\u3088\uFF09"
    english: 'The price keeps climbing!

      It''s getting too expensive, so let''s
      fold. Press the fold button!

      (It uses one pass.)'
  - key: tutorial.bid.win
    japanese: "\u4ECA\u5EA6\u306F\u5165\u672D\u3057\u3066\u843D\u672D\u3057\u3066\u307F\u3088\u3046\uFF01\n\u91D1\u984D\u3092\u6C7A\u3081\u3066\u3001\u5165\u672D\u30DC\u30BF\u30F3\u3092\u62BC\u305D\u3046\uFF01"
    english: 'This time, bid and win the auction!

      Set the amount and press
      the bid button!'
  - key: tutorial.final.intro
    japanese: "\u6B8B\u308A\u304C2\u4EBA\u306B\u306A\u3063\u305F\u306E\u3067 FINAL
      BATTLE\uFF01\n\u3053\u3053\u304B\u3089\u306F\u30EB\u30FC\u30EB\u304C\u5C11\u3057\u5909\u308F\u308B\u3088\uFF01"
    english: 'Only two players remain: FINAL BATTLE!

      Some rules change from
      here!'
  - key: tutorial.final.proceeds
    japanese: "\u843D\u672D\u3055\u308C\u3066\u3082\u4EE3\u91D1\u306F\u51FA\u54C1\u8005\u306B\u5165\u3089\u305A\u6D88\u3048\u308B\u3088\uFF01\n\u30C9\u30ED\u30FC\u306E\u30D0\u30D5\u30C7\u30D0\u30D5\u30AB\u30FC\u30C9\u306F\n\u30C7\u30D0\u30D5\u30AB\u30FC\u30C9\u3060\u3051\u306B\u306A\u308A\u3001\u679A\u6570\u3082\u5897\u3048\u308B\u3088\uFF01"
    english: 'Winning bids no longer pay the seller; the coins vanish!

      Drawn
      effect cards are debuffs only,

      and you get more of them!'
  - key: tutorial.final.drain
    japanese: "2\u4EBA\u3068\u3082\u898B\u9001\u308A\u6A29\u304C0\u679A\u306B\u306A\u308B\u3068\u3001\u6700\u4F4E\u984D\u3088\u308A\u591A\u304F\u5165\u672D\u3057\u3066\n\u843D\u672D\u3057\u305F\u5206\u3060\u3051\u3001\u51FA\u54C1\u8005\u306E\u30B3\u30A4\u30F3\u3092\u524A\u308C\u308B\u3088\uFF01\n\uFF08\u3069\u3061\u3089\u304B\u304C\u898B\u9001\u308A\u6A29\u3092\u6301\u3063\u3066\u3044\u308B\u9593\u306F\u524A\u308C\u306A\u3044\uFF09"
    english: 'Once both players have zero passes, bidding above the minimum

      drains
      the seller''s coins by the difference!

      (No draining while either player
      still has a pass.)'
  - key: tutorial.special.open_hand
    japanese: "1\u5468\u3057\u305F\u306E\u3067\u30C9\u30ED\u30FC\uFF01\u30EC\u30A2\u30EA\u30C6\u30A3\u300C\u9AD8\u300D\u306E\n\u30AB\u30FC\u30C9\u3092\u5F15\u3044\u305F\u3088\uFF01\u624B\u672D\u3092\u898B\u3066\u307F\u3088\u3046\uFF01"
    english: 'A full round passed, so everyone drew!

      You got a top-rarity
      card! Let''s look at your hand!'
  - key: tutorial.special.look
    japanese: "\u30EC\u30A2\u30EA\u30C6\u30A3\u300C\u9AD8\u300D\u306E\u30AB\u30FC\u30C9\u306B\u306F\u3001\u30B9\u30DA\u30B7\u30E3\u30EB\u30AB\u30FC\u30C9\u304C\n\u4ED8\u3044\u3066\u3044\u308B\u3088\uFF01\u30AB\u30FC\u30BD\u30EB\u3092\u5408\u308F\u305B\u3066\u307F\u3088\u3046\uFF01"
    english: 'Top-rarity cards come with a special card!

      Hover over the card!'
  - key: tutorial.special.hover
    japanese: "\u4E0A\u306B\u51FA\u305F\u306E\u304C\u30B9\u30DA\u30B7\u30E3\u30EB\u30AB\u30FC\u30C9\uFF01\n\u30AB\u30FC\u30BD\u30EB\u3092\u5408\u308F\u305B\u308B\u3068\u52B9\u679C\u304C\u898B\u3089\u308C\u308B\u3088\uFF01"
    english: 'The card shown above is the special card!

      Hover over it to see
      its effect!'
  - key: tutorial.special.detail
    japanese: "\u30B9\u30DA\u30B7\u30E3\u30EB\u30AB\u30FC\u30C9\u306E\u52B9\u679C\u3082\u3001\u843D\u672D\u3057\u305F\u4EBA\u306B\u767A\u52D5\u3059\u308B\u3088\uFF01\n\u8AB0\u3082\u843D\u672D\u3057\u306A\u3051\u308C\u3070\u51FA\u54C1\u8005\u306B\u767A\u52D5\u3059\u308B\u3088\uFF01"
    english: 'Special cards also take effect on the winner!

      If nobody wins,
      they take effect on the seller!'
  - key: tutorial.free
    japanese: "\u3053\u3053\u304B\u3089\u306F\u81EA\u7531\u306B\u64CD\u4F5C\u3057\u3066\u307F\u3088\u3046\uFF01\n\u6700\u5F8C\u306E1\u4EBA\u307E\u3067\u6B8B\u308C\u3070\u52DD\u5229\u3060\u3088\uFF01"
    english: 'From here on, play however you like!

      Be the last one standing
      to win!'
  - key: tutorial.clear
    japanese: "\u304A\u3081\u3067\u3068\u3046\uFF01\u6700\u5F8C\u306E1\u4EBA\u306B\u306A\u3063\u305F\u306E\u3067\u52DD\u5229\uFF01\n\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u30AF\u30EA\u30A2\uFF01"
    english: 'Congratulations! You''re the last one standing!

      Tutorial complete!'
  - key: tutorial.item.get
    japanese: "\u30A2\u30A4\u30C6\u30E0\u3092\u624B\u306B\u5165\u308C\u305F\uFF01\n\u30AA\u30FC\u30AF\u30B7\u30E7\u30F3\u3067\u843D\u672D\u3059\u308B\u3068\u3001\u30A2\u30A4\u30C6\u30E0\u30921\u3064\u3082\u3089\u3048\u308B\u3088\u3002\n\u4ECA\u56DE\u306F\u7DF4\u7FD2\u7528\u306B3\u3064\u6E21\u3059\u306D\uFF01"
    english: 'You got items!

      Win an auction to get one item.

      Here are
      three to practice with!'
  - key: tutorial.item.when
    japanese: "\u30A2\u30A4\u30C6\u30E0\u306F\u5DE6\u4E0B\u306E\u30DE\u30B9\u306B\u5165\u308B\u3088\uFF08\u6700\u59273\u3064\uFF09\u3002\n\u30AA\u30FC\u30AF\u30B7\u30E7\u30F3\u306E\u9593\u306A\u3089\u3001\u51FA\u54C1\u8005\u3067\u3082\u89B3\u6226\u4E2D\u3067\u3082\n\u30DE\u30B9\u306E\u30AF\u30EA\u30C3\u30AF\u304B
      1\u30FB2\u30FB3 \u30AD\u30FC\u3067\u4F7F\u3048\u308B\u3088\uFF01"
    english: 'Items go in the slots at the bottom left (up to 3).

      During an
      auction, anyone can use them

      by clicking a slot or pressing 1, 2 or
      3!'
  - key: tutorial.item.magnifier
    japanese: "\u866B\u773C\u93E1\u3092\u4F7F\u3063\u3066\u307F\u3088\u3046\uFF01\n\u51FA\u54C1\u306B\u4ED8\u3044\u3066\u3044\u308B\u52B9\u679C\u30AB\u30FC\u30C9\u3092\n\u81EA\u5206\u3060\u3051\u898B\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3088\uFF01"
    english: 'Try the magnifier!

      It lets only you see the effect cards

      attached
      to the listing!'
  - key: tutorial.item.plug
    japanese: "\u96FB\u6C17\u30D7\u30E9\u30B0\u3092\u4F7F\u3063\u3066\u307F\u3088\u3046\uFF01\n\u30B7\u30FC\u30EB\u30C9\u30921\u679A\u8CBC\u308C\u308B\u3088\uFF01"
    english: 'Try the power plug!

      It gives you one shield!'
  - key: tutorial.item.shield
    japanese: "\u30B7\u30FC\u30EB\u30C9\u304C\u8CBC\u3089\u308C\u305F\uFF01\n\u898B\u9001\u308A\u6A29\u3092\u4F7F\u3046\u3068\u304D\u3001\u4EE3\u308F\u308A\u306B\u30B7\u30FC\u30EB\u30C9\u304C\u4F7F\u308F\u308C\u308B\u3088\u3002\n\u6B8B\u3063\u3066\u3044\u308B\u9593\u306F\u3001\u304B\u304B\u3063\u3066\u3044\u308B\u52B9\u679C\u306E\u4E00\u89A7\u306B\u51FA\u3066\u3044\u308B\u3088\uFF01"
    english: 'Shield up!

      When you would use a pass ticket, the shield is used
      instead.

      While it lasts, it is shown in your active effects list!'
  - key: tutorial.item.remote
    japanese: "\u30EA\u30E2\u30B3\u30F3\u3092\u4F7F\u3063\u3066\u307F\u3088\u3046\uFF01\n\u9078\u3093\u3060\u76F8\u624B\u3092\u30DE\u30D2\u3055\u305B\u3066\u3001\n\u305D\u306E\u4EBA\u306E\u6B21\u306E\u51FA\u54C1\u30BF\u30FC\u30F3\u3092\u98DB\u3070\u305B\u308B\u3088\uFF01"
    english: 'Try the remote!

      Paralyze a player to skip

      their next
      listing turn!'
  - key: tutorial.item.remote_pick
    japanese: "\u30DE\u30D2\u3055\u305B\u308B\u76F8\u624B\u3092\u9078\u307C\u3046\uFF01\n\u982D\u306E\u4E0A\u306E\u540D\u524D\u3092\u62BC\u3057\u3066\u306D\uFF08\u53F3\u30AF\u30EA\u30C3\u30AF\u3067\u3084\u3081\u308B\uFF09"
    english: 'Choose who to paralyze!

      Click a name above their head (right-click
      to cancel).'
  - key: tutorial.item.paralysis
    japanese: "\u30DE\u30D2\u3055\u305B\u305F\uFF01\n\u30DE\u30D2\u3057\u305F\u4EBA\u306F\u9752\u767D\u3044\u96FB\u6C17\u306B\u5305\u307E\u308C\u3066\u3001\n\u6B21\u306E\u51FA\u54C1\u30BF\u30FC\u30F3\u304C\u98DB\u3070\u3055\u308C\u308B\u3088\uFF01"
    english: 'Paralyzed!

      They are wrapped in blue-white sparks,

      and
      their next listing turn is skipped!'
