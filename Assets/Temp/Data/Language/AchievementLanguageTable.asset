    japanese: "\uFF1F\uFF1F\uFF1F"
    english: ???
  - key: trophy.hidden_description
    japanese: "\u96A0\u3057\u5B9F\u7E3E"
    english: Hidden achievement
  - key: trophy.unlocked_at
    japanese: "{0:yyyy/MM/dd} \u89E3\u9664"
    english: Unlocked {0:yyyy/MM/dd}
