%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ffa302fe71f764f4f8464c345ab9ca1c, type: 3}
  m_Name: TutorialLanguageTable
  m_EditorClassIdentifier: Assembly-CSharp::LanguageTable
  entries:
  - key: tutorial.intro.welcome
    japanese: "CuratorJack\u3078\u3088\u3046\u3053\u305D\uFF01\n\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u3084\u3063\u3066\u307F\u3088\u3046\uFF01"
    english: 'Welcome to CuratorJack!

      Let''s try the tutorial!'
    chineseSimplified: "\u6B22\u8FCE\u6765\u5230 CuratorJack\uFF01\n\u4E00\u8D77\u6765\u8BD5\u8BD5\u6559\u7A0B\u5427\uFF01"
    chineseTraditional: "\u6B61\u8FCE\u4F86\u5230 CuratorJack\uFF01\n\u4E00\u8D77\u4F86\u8A66\u8A66\u6559\u7A0B\u5427\uFF01"
  - key: tutorial.click_hint
    japanese: "\u30AF\u30EA\u30C3\u30AF\u3067\u6B21\u3078"
    english: Click to continue
    chineseSimplified: "\u70B9\u51FB\u7EE7\u7EED"
    chineseTraditional: "\u9EDE\u9078\u7E7C\u7E8C"
  - key: tutorial.seller.open_hand
    japanese: "\u307E\u305A\u306F\u51FA\u54C1\u8005\u30BF\u30FC\u30F3\uFF01\n\u307E\u305A\u306F\u81EA\u5206\u306E\u30AB\u30FC\u30C9\u3092\u898B\u3066\u307F\u3088\u3046\uFF01"
    english: 'First up is the seller''s turn!

      Let''s start by looking at your
      cards!'
    chineseSimplified: "\u9996\u5148\u662F\u5356\u5BB6\u56DE\u5408\uFF01\n\u5148\u6765\u770B\u770B\u81EA\u5DF1\u7684\u5361\u724C\u5427\uFF01"
    chineseTraditional: "\u9996\u5148\u662F\u8CE3\u5BB6\u56DE\u5408\uFF01\n\u5148\u4F86\u770B\u770B\u81EA\u5DF1\u7684\u5361\u724C\u5427\uFF01"
  - key: tutorial.seller.look_goods
    japanese: "\u51FA\u54C1\u30AB\u30FC\u30C9\u3092\u898B\u3066\u307F\u3088\u3046\uFF01"
    english: Let's look at a listing card!
    chineseSimplified: "\u6765\u770B\u770B\u4E0A\u62CD\u5361\u5427\uFF01"
    chineseTraditional: "\u4F86\u770B\u770B\u4E0A\u62CD\u5361\u5427\uFF01"
  - key: tutorial.seller.card_detail
    japanese: "\u3053\u306E\u3088\u3046\u306B\u30AB\u30FC\u30C9\u306E\u8A73\u7D30\u3092\n\u898B\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3088\uFF01"
    english: 'This is how you can see

      a card''s details!'
    chineseSimplified: "\u50CF\u8FD9\u6837\u5C31\u80FD\u67E5\u770B\n\u5361\u724C\u7684\u8BE6\u7EC6\u4FE1\u606F\uFF01"
    chineseTraditional: "\u50CF\u9019\u6A23\u5C31\u80FD\u6AA2\u8996\n\u5361\u724C\u7684\u8A73\u7D30\u8CC7\u8A0A\uFF01"
  - key: tutorial.seller.select_goods
    japanese: "\u30AB\u30FC\u30C9\u3092\u9078\u629E\u3057\u3066\u307F\u3088\u3046\uFF01"
    english: Let's select the card!
    chineseSimplified: "\u9009\u62E9\u8FD9\u5F20\u5361\u724C\u5427\uFF01"
    chineseTraditional: "\u9078\u64C7\u9019\u5F35\u5361\u724C\u5427\uFF01"
  - key: tutorial.seller.attach_buff
    japanese: "\u6B21\u306F\u30A8\u30D5\u30A7\u30AF\u30C8\u30AB\u30FC\u30C9\u3092\u3064\u3051\u3066\u307F\u3088\u3046\uFF01"
    english: Next, let's attach an effect card!
    chineseSimplified: "\u63A5\u4E0B\u6765\u9644\u52A0\u4E00\u5F20\u6548\u679C\u5361\u5427\uFF01"
    chineseTraditional: "\u63A5\u4E0B\u4F86\u9644\u52A0\u4E00\u5F35\u6548\u679C\u5361\u5427\uFF01"
  - key: tutorial.seller.raise
    japanese: "\u30A8\u30D5\u30A7\u30AF\u30C8\u30AB\u30FC\u30C9\u304C\u3064\u3044\u3066\u3044\u308B\u51FA\u54C1\u306B\u306F\n\u4ED8\u52A0\u4FA1\u5024\u3092\u3064\u3051\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3088\uFF01"
    english: 'Listings with effect cards

      can be given added value!'
    chineseSimplified: "\u9644\u6709\u6548\u679C\u5361\u7684\u62CD\u54C1\n\u53EF\u4EE5\u6DFB\u52A0\u9644\u52A0\u4EF7\u503C\uFF01"
    chineseTraditional: "\u9644\u6709\u6548\u679C\u5361\u7684\u62CD\u54C1\n\u53EF\u4EE5\u65B0\u589E\u9644\u52A0\u50F9\u503C\uFF01"
  - key: tutorial.seller.attach_debuff
    japanese: "\u30A8\u30D5\u30A7\u30AF\u30C8\u30AB\u30FC\u30C9\u306F\u51FA\u54C1\u30AB\u30FC\u30C9\u306B\n\u4F55\u679A\u3067\u3082\u3064\u3051\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3088\uFF01"
    english: 'You can attach as many effect cards

      as you like to a listing
      card!'
    chineseSimplified: "\u6548\u679C\u5361\u53EF\u4EE5\u5728\u4E0A\u62CD\u5361\u4E0A\n\u9644\u52A0\u4EFB\u610F\u5F20\u6570\uFF01"
    chineseTraditional: "\u6548\u679C\u5361\u53EF\u4EE5\u5728\u4E0A\u62CD\u5361\u4E0A\n\u9644\u52A0\u4EFB\u610F\u5F35\u6578\uFF01"
  - key: tutorial.seller.confirm
    japanese: "\u78BA\u5B9A\u3092\u62BC\u3057\u3066\u51FA\u54C1\u3057\u3066\u307F\u3088\u3046\uFF01"
    english: Press confirm to list it!
    chineseSimplified: "\u6309\u4E0B\u786E\u8BA4\u6765\u4E0A\u62CD\u5427\uFF01"
    chineseTraditional: "\u6309\u4E0B\u78BA\u8A8D\u4F86\u4E0A\u62CD\u5427\uFF01"
  - key: tutorial.auction.intro
    japanese: "\u30AA\u30FC\u30AF\u30B7\u30E7\u30F3\u958B\u59CB\uFF01\u51FA\u54C1\u8005\u4EE5\u5916\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\n\u5165\u672D\u3059\u308B\u304B\u964D\u308A\u308B\u304B\u3092\u9078\u3076\u3088\uFF01"
    english: 'The auction begins! Everyone except the seller

      chooses to bid
      or fold!'
    chineseSimplified: "\u62CD\u5356\u5F00\u59CB\uFF01\u9664\u5356\u5BB6\u4EE5\u5916\u7684\u73A9\u5BB6\n\u8981\u9009\u62E9\u51FA\u4EF7\u8FD8\u662F\u653E\u5F03\uFF01"
    chineseTraditional: "\u62CD\u8CE3\u958B\u59CB\uFF01\u9664\u8CE3\u5BB6\u4EE5\u5916\u7684\u73A9\u5BB6\n\u8981\u9078\u64C7\u51FA\u50F9\u9084\u662F\u653E\u68C4\uFF01"
  - key: tutorial.auction.sold
    japanese: "\u76F8\u624B\u304C\u843D\u672D\u3057\u305F\u306E\u3067\u3001\u4ED8\u3051\u305F\u30A8\u30D5\u30A7\u30AF\u30C8\u30AB\u30FC\u30C9\u306F\n\u843D\u672D\u3057\u305F\u30D7\u30EC\u30A4\u30E4\u30FC\u306B\u767A\u52D5\u3059\u308B\u3088\uFF01"
    english: 'An opponent won the auction, so the attached

      effect cards take
      effect on the winner!'
    chineseSimplified: "\u5BF9\u624B\u62CD\u5F97\u4E86\uFF0C\u6240\u4EE5\u9644\u52A0\u7684\u6548\u679C\u5361\n\u4F1A\u5BF9\u62CD\u5F97\u7684\u73A9\u5BB6\u751F\u6548\uFF01"
    chineseTraditional: "\u5C0D\u624B\u62CD\u5F97\u4E86\uFF0C\u6240\u4EE5\u9644\u52A0\u7684\u6548\u679C\u5361\n\u6703\u5C0D\u62CD\u5F97\u7684\u73A9\u5BB6\u751F\u6548\uFF01"
  - key: tutorial.auction.unsold
    japanese: "\u3082\u3057\u8AB0\u3082\u843D\u672D\u3057\u306A\u304B\u3063\u305F\u3068\u304D\u306F\u3001\u30A8\u30D5\u30A7\u30AF\u30C8\u30AB\u30FC\u30C9\u306F\n\u51FA\u54C1\u8005\u306E\u81EA\u5206\u306B\u767A\u52D5\u3059\u308B\u3088\uFF01"
    english: 'If nobody wins the auction, the effect cards

      take effect on
      you, the seller!'
    chineseSimplified: "\u5982\u679C\u6CA1\u6709\u4EBA\u62CD\u5F97\uFF0C\u6548\u679C\u5361\n\u4F1A\u5BF9\u5356\u5BB6\uFF0C\u4E5F\u5C31\u662F\u4F60\u81EA\u5DF1\u751F\u6548\uFF01"
    chineseTraditional: "\u5982\u679C\u6C92\u6709\u4EBA\u62CD\u5F97\uFF0C\u6548\u679C\u5361\n\u6703\u5C0D\u8CE3\u5BB6\uFF0C\u4E5F\u5C31\u662F\u4F60\u81EA\u5DF1\u751F\u6548\uFF01"
  - key: tutorial.auction.fold
    japanese: "\u964D\u308A\u305F\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u898B\u9001\u308A\u6A29\u30921\u679A\u4F7F\u3046\u3088\uFF01\n\u673A\u306E\u4E0A\u306E\u30C1\u30B1\u30C3\u30C8\u306E\u679A\u6570\u304C\u4ECA\u306E\u898B\u9001\u308A\u6A29\uFF08HP\uFF09\uFF01\n\u898B\u9001\u308A\u6A29\u304C0\u679A\u306E\u3068\u304D\u306B\u964D\u308A\u308B\u3068\u8131\u843D\uFF01"
    english: 'Players who fold use up one pass!

      The tickets on the desk show
      the passes (HP) left.

      Folding with zero passes knocks you out!'
    chineseSimplified: "\u653E\u5F03\u7684\u73A9\u5BB6\u8981\u4F7F\u75281\u5F20\u5F03\u6743\u5238\uFF01\n\u684C\u4E0A\u7684\u7968\u6570\u5C31\u662F\u5F53\u524D\u7684\u5F03\u6743\u5238\uFF08HP\uFF09\uFF01\n\u5F03\u6743\u5238\u4E3A0\u5F20\u65F6\u653E\u5F03\u5C31\u4F1A\u88AB\u6DD8\u6C70\uFF01"
    chineseTraditional: "\u653E\u68C4\u7684\u73A9\u5BB6\u8981\u4F7F\u75281\u5F35\u68C4\u6B0A\u5238\uFF01\n\u684C\u4E0A\u7684\u7968\u6578\u5C31\u662F\u7576\u524D\u7684\u68C4\u6B0A\u5238\uFF08HP\uFF09\uFF01\n\u68C4\u6B0A\u5238\u70BA0\u5F35\u6642\u653E\u68C4\u5C31\u6703\u88AB\u6DD8\u6C70\uFF01"
  - key: tutorial.info.open
    japanese: "\u30A4\u30F3\u30D5\u30A9\u30E1\u30FC\u30B7\u30E7\u30F3\u30DE\u30FC\u30AF\u3092\u62BC\u3059\u3068\u3001\n\u30AB\u30FC\u30C9\u306E\u4E00\u89A7\u304C\u898B\u3089\u308C\u308B\u3088\uFF01\u62BC\u3057\u3066\u307F\u3088\u3046\uFF01"
    english: 'Press the information mark

      to see the list of cards! Give it
      a try!'
    chineseSimplified: "\u6309\u4E0B\u4FE1\u606F\u6807\u5FD7\uFF0C\n\u5C31\u80FD\u67E5\u770B\u5361\u724C\u4E00\u89C8\uFF01\u6309\u4E00\u4E0B\u8BD5\u8BD5\uFF01"
    chineseTraditional: "\u6309\u4E0B\u8CC7\u8A0A\u6A19\u8A8C\uFF0C\n\u5C31\u80FD\u6AA2\u8996\u5361\u724C\u4E00\u89BD\uFF01\u6309\u4E00\u4E0B\u8A66\u8A66\uFF01"
  - key: tutorial.info.catalog
    japanese: "\u4E0A\u306E\u30BF\u30D6\u3067\u5546\u54C1\u30FB\u30A8\u30D5\u30A7\u30AF\u30C8\u30FB\u30B9\u30DA\u30B7\u30E3\u30EB\u3092\u5207\u308A\u66FF\u3048\u3089\u308C\u308B\u3088\uFF01\n\u30A6\u30A3\u30F3\u30C9\u30A6\u306E\u5916\u3092\u62BC\u3059\u3068\u9589\u3058\u308B\u3088\uFF01"
    english: 'Use the tabs at the top to switch between goods, effects and specials!

      Click
      outside the window to close it!'
    chineseSimplified: "\u7528\u4E0A\u65B9\u7684\u6807\u7B7E\u53EF\u4EE5\u5207\u6362\u5546\u54C1\u3001\u6548\u679C\u3001\u7279\u6B8A\u5361\uFF01\n\u70B9\u51FB\u7A97\u53E3\u5916\u9762\u5373\u53EF\u5173\u95ED\uFF01"
    chineseTraditional: "\u7528\u4E0A\u65B9\u7684\u6A19\u7C64\u53EF\u4EE5\u5207\u63DB\u5546\u54C1\u3001\u6548\u679C\u3001\u7279\u6B8A\u5361\uFF01\n\u9EDE\u9078\u8996\u7A97\u5916\u9762\u5373\u53EF\u95DC\u9589\uFF01"
  - key: tutorial.inspect.open
    japanese: "\u866B\u773C\u93E1\u30DE\u30FC\u30AF\u3092\u62BC\u3059\u3068\u3001\u305D\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\n\u624B\u5143\u3092\u8FD1\u304F\u3067\u898B\u3089\u308C\u308B\u3088\uFF01\u62BC\u3057\u3066\u307F\u3088\u3046\uFF01"
    english: 'Press a magnifier mark to take a closer look

      at that player''s
      spot!'
    chineseSimplified: "\u6309\u4E0B\u653E\u5927\u955C\u6807\u5FD7\uFF0C\u5C31\u80FD\u8FD1\u8DDD\u79BB\u67E5\u770B\n\u8BE5\u73A9\u5BB6\u7684\u684C\u9762\uFF01\u6309\u4E00\u4E0B\u8BD5\u8BD5\uFF01"
    chineseTraditional: "\u6309\u4E0B\u653E\u5927\u93E1\u6A19\u8A8C\uFF0C\u5C31\u80FD\u8FD1\u8DDD\u96E2\u6AA2\u8996\n\u8A72\u73A9\u5BB6\u7684\u684C\u9762\uFF01\u6309\u4E00\u4E0B\u8A66\u8A66\uFF01"
  - key: tutorial.inspect.view
    japanese: "\u30C1\u30B1\u30C3\u30C8\u306E\u679A\u6570\u304C\u305D\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u898B\u9001\u308A\u6A29\uFF08HP\uFF09\u3001\n\u7A4D\u307E\u308C\u3066\u3044\u308B\u30AB\u30FC\u30C9\u304C\u843D\u672D\u3057\u305F\u30AB\u30FC\u30C9\u3060\u3088\uFF01"
    english: 'The tickets are that player''s passes (HP),

      and the stacked
      cards are the cards they won!'
    chineseSimplified: "\u7968\u6570\u662F\u8BE5\u73A9\u5BB6\u7684\u5F03\u6743\u5238\uFF08HP\uFF09\uFF0C\n\u53E0\u653E\u7684\u5361\u724C\u662F\u62CD\u5F97\u7684\u5361\u724C\uFF01"
    chineseTraditional: "\u7968\u6578\u662F\u8A72\u73A9\u5BB6\u7684\u68C4\u6B0A\u5238\uFF08HP\uFF09\uFF0C\n\u758A\u653E\u7684\u5361\u724C\u662F\u62CD\u5F97\u7684\u5361\u724C\uFF01"
  - key: tutorial.bid.intro
    japanese: "\u4ECA\u5EA6\u306F\u5165\u672D\u3057\u3066\u307F\u3088\u3046\uFF01W/S
      \u304B \u2191/\u2193 \u3067\u91D1\u984D\u3092\u6C7A\u3081\u3066\u3001\n\u5165\u672D\u30DC\u30BF\u30F3\u3092\u62BC\u305D\u3046\uFF01"
    english: "Now let's try bidding! Set the amount with W/S or \u2191/\u2193,\nthen
      press the bid button!"
    chineseSimplified: "\u8FD9\u6B21\u6765\u51FA\u4EF7\u5427\uFF01\u7528 W/S \u6216
      \u2191/\u2193 \u51B3\u5B9A\u91D1\u989D\uFF0C\n\u7136\u540E\u6309\u4E0B\u51FA\u4EF7\u6309\u94AE\uFF01"
    chineseTraditional: "\u9019\u6B21\u4F86\u51FA\u50F9\u5427\uFF01\u7528 W/S \u6216
      \u2191/\u2193 \u6C7A\u5B9A\u91D1\u984D\uFF0C\n\u7136\u5F8C\u6309\u4E0B\u51FA\u50F9\u6309\u9215\uFF01"
  - key: tutorial.fold.leader
    japanese: "\u4ECA\u306F\u81EA\u5206\u304C\u6700\u9AD8\u984D\uFF01\n\u6700\u9AD8\u984D\u306E\u3042\u3044\u3060\u306F\u964D\u308A\u3089\u308C\u306A\u3044\u3088\uFF01"
    english: 'You''re the highest bidder now!

      You can''t fold while you hold
      the highest bid!'
    chineseSimplified: "\u73B0\u5728\u4F60\u662F\u6700\u9AD8\u51FA\u4EF7\u8005\uFF01\n\u4F5C\u4E3A\u6700\u9AD8\u51FA\u4EF7\u8005\u65F6\u4E0D\u80FD\u653E\u5F03\uFF01"
    chineseTraditional: "\u73FE\u5728\u4F60\u662F\u6700\u9AD8\u51FA\u50F9\u8005\uFF01\n\u4F5C\u70BA\u6700\u9AD8\u51FA\u50F9\u8005\u6642\u4E0D\u80FD\u653E\u68C4\uFF01"
  - key: tutorial.bid.raise
    japanese: "\u4E0A\u56DE\u3089\u308C\u305F\uFF01\n\u91D1\u984D\u3092\u4E0A\u3052\u3066\u5165\u672D\u3057\u8FD4\u305D\u3046\uFF01"
    english: 'You''ve been outbid!

      Raise the amount and bid back!'
    chineseSimplified: "\u88AB\u8D85\u8FC7\u4E86\uFF01\n\u63D0\u9AD8\u91D1\u989D\u518D\u6B21\u51FA\u4EF7\u5427\uFF01"
    chineseTraditional: "\u88AB\u8D85\u904E\u4E86\uFF01\n\u63D0\u9AD8\u91D1\u984D\u518D\u6B21\u51FA\u50F9\u5427\uFF01"
  - key: tutorial.fold.outbid
    japanese: "\u5024\u6BB5\u304C\u3069\u3093\u3069\u3093\u4E0A\u304C\u3063\u3066\u304D\u305F\uFF01\n\u3053\u308C\u4EE5\u4E0A\u306F\u9AD8\u3059\u304E\u308B\u306E\u3067\u964D\u308A\u3088\u3046\u3002\u964D\u308A\u308B\u30DC\u30BF\u30F3\u3092\u62BC\u305D\u3046\uFF01\n\uFF08\u898B\u9001\u308A\u6A29\u30921\u679A\u4F7F\u3046\u3088\uFF09"
    english: 'The price keeps climbing!

      It''s getting too expensive, so let''s
      fold. Press the fold button!

      (It uses one pass.)'
    chineseSimplified: "\u4EF7\u683C\u8D8A\u6765\u8D8A\u9AD8\u4E86\uFF01\n\u518D\u9AD8\u5C31\u592A\u8D35\u4E86\uFF0C\u653E\u5F03\u5427\u3002\u6309\u4E0B\u653E\u5F03\u6309\u94AE\uFF01\n\uFF08\u4F1A\u4F7F\u75281\u5F20\u5F03\u6743\u5238\uFF09"
    chineseTraditional: "\u50F9\u683C\u8D8A\u4F86\u8D8A\u9AD8\u4E86\uFF01\n\u518D\u9AD8\u5C31\u592A\u8CB4\u4E86\uFF0C\u653E\u68C4\u5427\u3002\u6309\u4E0B\u653E\u68C4\u6309\u9215\uFF01\n\uFF08\u6703\u4F7F\u75281\u5F35\u68C4\u6B0A\u5238\uFF09"
  - key: tutorial.bid.win
    japanese: "\u4ECA\u5EA6\u306F\u5165\u672D\u3057\u3066\u843D\u672D\u3057\u3066\u307F\u3088\u3046\uFF01\n\u91D1\u984D\u3092\u6C7A\u3081\u3066\u3001\u5165\u672D\u30DC\u30BF\u30F3\u3092\u62BC\u305D\u3046\uFF01"
    english: 'This time, bid and win the auction!

      Set the amount and press
      the bid button!'
    chineseSimplified: "\u8FD9\u6B21\u51FA\u4EF7\u5E76\u62CD\u4E0B\u5427\uFF01\n\u51B3\u5B9A\u91D1\u989D\u540E\u6309\u4E0B\u51FA\u4EF7\u6309\u94AE\uFF01"
    chineseTraditional: "\u9019\u6B21\u51FA\u50F9\u4E26\u62CD\u4E0B\u5427\uFF01\n\u6C7A\u5B9A\u91D1\u984D\u5F8C\u6309\u4E0B\u51FA\u50F9\u6309\u9215\uFF01"
  - key: tutorial.final.intro
    japanese: "\u6B8B\u308A\u304C2\u4EBA\u306B\u306A\u3063\u305F\u306E\u3067 FINAL
      BATTLE\uFF01\n\u3053\u3053\u304B\u3089\u306F\u30EB\u30FC\u30EB\u304C\u5C11\u3057\u5909\u308F\u308B\u3088\uFF01"
    english: 'Only two players remain: FINAL BATTLE!

      Some rules change from
      here!'
    chineseSimplified: "\u53EA\u52692\u4EBA\u4E86\uFF0C\u8FDB\u5165 FINAL BATTLE\uFF01\n\u4ECE\u8FD9\u91CC\u5F00\u59CB\u89C4\u5219\u4F1A\u6709\u4E9B\u53D8\u5316\uFF01"
    chineseTraditional: "\u53EA\u52692\u4EBA\u4E86\uFF0C\u9032\u5165 FINAL BATTLE\uFF01\n\u5F9E\u9019\u88E1\u958B\u59CB\u898F\u5247\u6703\u6709\u4E9B\u8B8A\u5316\uFF01"
  - key: tutorial.final.proceeds
    japanese: "\u843D\u672D\u3055\u308C\u3066\u3082\u4EE3\u91D1\u306F\u51FA\u54C1\u8005\u306B\u5165\u3089\u305A\u6D88\u3048\u308B\u3088\uFF01\n\u30C9\u30ED\u30FC\u306E\u30D0\u30D5\u30C7\u30D0\u30D5\u30AB\u30FC\u30C9\u306F\n\u30C7\u30D0\u30D5\u30AB\u30FC\u30C9\u3060\u3051\u306B\u306A\u308A\u3001\u679A\u6570\u3082\u5897\u3048\u308B\u3088\uFF01"
    english: 'Winning bids no longer pay the seller; the coins vanish!

      Drawn
      effect cards are debuffs only,

      and you get more of them!'
    chineseSimplified: "\u5373\u4F7F\u88AB\u62CD\u5F97\uFF0C\u8D27\u6B3E\u4E5F\u4E0D\u4F1A\u7ED9\u5356\u5BB6\uFF0C\u800C\u662F\u76F4\u63A5\u6D88\u5931\uFF01\n\u62BD\u5230\u7684\u589E\u76CA/\u51CF\u76CA\u5361\n\u53EA\u4F1A\u662F\u51CF\u76CA\u5361\uFF0C\u800C\u4E14\u5F20\u6570\u4F1A\u589E\u52A0\uFF01"
    chineseTraditional: "\u5373\u4F7F\u88AB\u62CD\u5F97\uFF0C\u8CA8\u6B3E\u4E5F\u4E0D\u6703\u7D66\u8CE3\u5BB6\uFF0C\u800C\u662F\u76F4\u63A5\u6D88\u5931\uFF01\n\u62BD\u5230\u7684\u589E\u76CA/\u6E1B\u76CA\u5361\n\u53EA\u6703\u662F\u6E1B\u76CA\u5361\uFF0C\u800C\u4E14\u5F35\u6578\u6703\u589E\u52A0\uFF01"
  - key: tutorial.final.drain
    japanese: "2\u4EBA\u3068\u3082\u898B\u9001\u308A\u6A29\u304C0\u679A\u306B\u306A\u308B\u3068\u3001\u6700\u4F4E\u984D\u3088\u308A\u591A\u304F\u5165\u672D\u3057\u3066\n\u843D\u672D\u3057\u305F\u5206\u3060\u3051\u3001\u51FA\u54C1\u8005\u306E\u30B3\u30A4\u30F3\u3092\u524A\u308C\u308B\u3088\uFF01\n\uFF08\u3069\u3061\u3089\u304B\u304C\u898B\u9001\u308A\u6A29\u3092\u6301\u3063\u3066\u3044\u308B\u9593\u306F\u524A\u308C\u306A\u3044\uFF09"
    english: 'Once both players have zero passes, bidding above the minimum

      drains
      the seller''s coins by the difference!

      (No draining while either player
      still has a pass.)'
    chineseSimplified: "\u4E24\u4EBA\u7684\u5F03\u6743\u5238\u90FD\u4E3A0\u5F20\u540E\uFF0C\u6BD4\u5E95\u4EF7\u591A\u51FA\u4EF7\n\u62CD\u5F97\u7684\u90E8\u5206\uFF0C\u53EF\u4EE5\u524A\u51CF\u5356\u5BB6\u7684\u91D1\u5E01\uFF01\n\uFF08\u4EFB\u610F\u4E00\u65B9\u8FD8\u6709\u5F03\u6743\u5238\u65F6\u65E0\u6CD5\u524A\u51CF\uFF09"
    chineseTraditional: "\u5169\u4EBA\u7684\u68C4\u6B0A\u5238\u90FD\u70BA0\u5F35\u5F8C\uFF0C\u6BD4\u5E95\u50F9\u591A\u51FA\u50F9\n\u62CD\u5F97\u7684\u90E8\u5206\uFF0C\u53EF\u4EE5\u524A\u6E1B\u8CE3\u5BB6\u7684\u91D1\u5E63\uFF01\n\uFF08\u4EFB\u610F\u4E00\u65B9\u9084\u6709\u68C4\u6B0A\u5238\u6642\u7121\u6CD5\u524A\u6E1B\uFF09"
  - key: tutorial.special.open_hand
    japanese: "1\u5468\u3057\u305F\u306E\u3067\u30C9\u30ED\u30FC\uFF01\u30EC\u30A2\u30EA\u30C6\u30A3\u300C\u9AD8\u300D\u306E\n\u30AB\u30FC\u30C9\u3092\u5F15\u3044\u305F\u3088\uFF01\u624B\u672D\u3092\u898B\u3066\u307F\u3088\u3046\uFF01"
    english: 'A full round passed, so everyone drew!

      You got a top-rarity
      card! Let''s look at your hand!'
    chineseSimplified: "\u4E00\u8F6E\u7ED3\u675F\uFF0C\u62BD\u724C\uFF01\u62BD\u5230\u4E86\u7A00\u6709\u5EA6\u300C\u9AD8\u300D\u7684\n\u5361\u724C\uFF01\u770B\u770B\u624B\u724C\u5427\uFF01"
    chineseTraditional: "\u4E00\u8F2A\u7D50\u675F\uFF0C\u62BD\u724C\uFF01\u62BD\u5230\u4E86\u7A00\u6709\u5EA6\u300C\u9AD8\u300D\u7684\n\u5361\u724C\uFF01\u770B\u770B\u624B\u724C\u5427\uFF01"
  - key: tutorial.special.look
    japanese: "\u30EC\u30A2\u30EA\u30C6\u30A3\u300C\u9AD8\u300D\u306E\u30AB\u30FC\u30C9\u306B\u306F\u3001\u30B9\u30DA\u30B7\u30E3\u30EB\u30AB\u30FC\u30C9\u304C\n\u4ED8\u3044\u3066\u3044\u308B\u3088\uFF01\u30AB\u30FC\u30BD\u30EB\u3092\u5408\u308F\u305B\u3066\u307F\u3088\u3046\uFF01"
    english: 'Top-rarity cards come with a special card!

      Hover over the card!'
    chineseSimplified: "\u7A00\u6709\u5EA6\u300C\u9AD8\u300D\u7684\u5361\u724C\u9644\u6709\u7279\u6B8A\u5361\uFF01\n\u628A\u5149\u6807\u79FB\u4E0A\u53BB\u770B\u770B\uFF01"
    chineseTraditional: "\u7A00\u6709\u5EA6\u300C\u9AD8\u300D\u7684\u5361\u724C\u9644\u6709\u7279\u6B8A\u5361\uFF01\n\u628A\u6E38\u6A19\u79FB\u4E0A\u53BB\u770B\u770B\uFF01"
  - key: tutorial.special.hover
    japanese: "\u4E0A\u306B\u51FA\u305F\u306E\u304C\u30B9\u30DA\u30B7\u30E3\u30EB\u30AB\u30FC\u30C9\uFF01\n\u30AB\u30FC\u30BD\u30EB\u3092\u5408\u308F\u305B\u308B\u3068\u52B9\u679C\u304C\u898B\u3089\u308C\u308B\u3088\uFF01"
    english: 'The card shown above is the special card!

      Hover over it to see
      its effect!'
    chineseSimplified: "\u4E0A\u65B9\u51FA\u73B0\u7684\u5C31\u662F\u7279\u6B8A\u5361\uFF01\n\u628A\u5149\u6807\u79FB\u4E0A\u53BB\u5C31\u80FD\u770B\u5230\u6548\u679C\uFF01"
    chineseTraditional: "\u4E0A\u65B9\u51FA\u73FE\u7684\u5C31\u662F\u7279\u6B8A\u5361\uFF01\n\u628A\u6E38\u6A19\u79FB\u4E0A\u53BB\u5C31\u80FD\u770B\u5230\u6548\u679C\uFF01"
  - key: tutorial.special.detail
    japanese: "\u30B9\u30DA\u30B7\u30E3\u30EB\u30AB\u30FC\u30C9\u306E\u52B9\u679C\u3082\u3001\u843D\u672D\u3057\u305F\u4EBA\u306B\u767A\u52D5\u3059\u308B\u3088\uFF01\n\u8AB0\u3082\u843D\u672D\u3057\u306A\u3051\u308C\u3070\u51FA\u54C1\u8005\u306B\u767A\u52D5\u3059\u308B\u3088\uFF01"
    english: 'Special cards also take effect on the winner!

      If nobody wins,
      they take effect on the seller!'
    chineseSimplified: "\u7279\u6B8A\u5361\u7684\u6548\u679C\u4E5F\u4F1A\u5BF9\u62CD\u5F97\u8005\u751F\u6548\uFF01\n\u5982\u679C\u6CA1\u4EBA\u62CD\u5F97\uFF0C\u5219\u5BF9\u5356\u5BB6\u751F\u6548\uFF01"
    chineseTraditional: "\u7279\u6B8A\u5361\u7684\u6548\u679C\u4E5F\u6703\u5C0D\u62CD\u5F97\u8005\u751F\u6548\uFF01\n\u5982\u679C\u6C92\u4EBA\u62CD\u5F97\uFF0C\u5247\u5C0D\u8CE3\u5BB6\u751F\u6548\uFF01"
  - key: tutorial.free
    japanese: "\u3053\u3053\u304B\u3089\u306F\u81EA\u7531\u306B\u64CD\u4F5C\u3057\u3066\u307F\u3088\u3046\uFF01\n\u6700\u5F8C\u306E1\u4EBA\u307E\u3067\u6B8B\u308C\u3070\u52DD\u5229\u3060\u3088\uFF01"
    english: 'From here on, play however you like!

      Be the last one standing
      to win!'
    chineseSimplified: "\u4ECE\u8FD9\u91CC\u5F00\u59CB\u81EA\u7531\u64CD\u4F5C\u5427\uFF01\n\u575A\u6301\u5230\u6700\u540E1\u4EBA\u5C31\u80FD\u83B7\u80DC\uFF01"
    chineseTraditional: "\u5F9E\u9019\u88E1\u958B\u59CB\u81EA\u7531\u64CD\u4F5C\u5427\uFF01\n\u5805\u6301\u5230\u6700\u5F8C1\u4EBA\u5C31\u80FD\u7372\u52DD\uFF01"
  - key: tutorial.clear
    japanese: "\u304A\u3081\u3067\u3068\u3046\uFF01\u6700\u5F8C\u306E1\u4EBA\u306B\u306A\u3063\u305F\u306E\u3067\u52DD\u5229\uFF01\n\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u30AF\u30EA\u30A2\uFF01"
    english: 'Congratulations! You''re the last one standing!

      Tutorial complete!'
    chineseSimplified: "\u606D\u559C\uFF01\u4F60\u662F\u6700\u540E1\u4EBA\uFF0C\u83B7\u5F97\u4E86\u80DC\u5229\uFF01\n\u6559\u7A0B\u5B8C\u6210\uFF01"
    chineseTraditional: "\u606D\u559C\uFF01\u4F60\u662F\u6700\u5F8C1\u4EBA\uFF0C\u7372\u5F97\u4E86\u52DD\u5229\uFF01\n\u6559\u7A0B\u5B8C\u6210\uFF01"
  - key: tutorial.item.get
    japanese: "\u30A2\u30A4\u30C6\u30E0\u3092\u624B\u306B\u5165\u308C\u305F\uFF01\n\u30AA\u30FC\u30AF\u30B7\u30E7\u30F3\u3067\u843D\u672D\u3059\u308B\u3068\u3001\u30A2\u30A4\u30C6\u30E0\u30921\u3064\u3082\u3089\u3048\u308B\u3088\u3002\n\u4ECA\u56DE\u306F\u7DF4\u7FD2\u7528\u306B3\u3064\u6E21\u3059\u306D\uFF01"
    english: 'You got items!

      Win an auction to get one item.

      Here are
      three to practice with!'
    chineseSimplified: "\u83B7\u5F97\u4E86\u9053\u5177\uFF01\n\u5728\u62CD\u5356\u4E2D\u62CD\u5F97\u5C31\u80FD\u83B7\u5F971\u4E2A\u9053\u5177\u3002\n\u8FD9\u6B21\u5148\u7ED9\u4F603\u4E2A\u7528\u6765\u7EC3\u4E60\uFF01"
    chineseTraditional: "\u7372\u5F97\u4E86\u9053\u5177\uFF01\n\u5728\u62CD\u8CE3\u4E2D\u62CD\u5F97\u5C31\u80FD\u7372\u5F971\u500B\u9053\u5177\u3002\n\u9019\u6B21\u5148\u7D66\u4F603\u500B\u7528\u4F86\u7DF4\u7FD2\uFF01"
  - key: tutorial.item.when
    japanese: "\u30A2\u30A4\u30C6\u30E0\u306F\u5DE6\u4E0B\u306E\u30DE\u30B9\u306B\u5165\u308B\u3088\uFF08\u6700\u59273\u3064\uFF09\u3002\n\u30AA\u30FC\u30AF\u30B7\u30E7\u30F3\u306E\u9593\u306A\u3089\u3001\u51FA\u54C1\u8005\u3067\u3082\u89B3\u6226\u4E2D\u3067\u3082\n\u30DE\u30B9\u306E\u30AF\u30EA\u30C3\u30AF\u304B
      1\u30FB2\u30FB3 \u30AD\u30FC\u3067\u4F7F\u3048\u308B\u3088\uFF01"
    english: 'Items go in the slots at the bottom left (up to 3).

      During an
      auction, anyone can use them

      by clicking a slot or pressing 1, 2 or
      3!'
    chineseSimplified: "\u9053\u5177\u4F1A\u653E\u8FDB\u5DE6\u4E0B\u89D2\u7684\u683C\u5B50\u91CC\uFF08\u6700\u591A3\u4E2A\uFF09\u3002\n\u62CD\u5356\u671F\u95F4\uFF0C\u65E0\u8BBA\u662F\u5356\u5BB6\u8FD8\u662F\u89C2\u6218\u4E2D\uFF0C\n\u90FD\u53EF\u4EE5\u70B9\u51FB\u683C\u5B50\u6216\u6309
      1\u30FB2\u30FB3 \u952E\u4F7F\u7528\uFF01"
    chineseTraditional: "\u9053\u5177\u6703\u653E\u9032\u5DE6\u4E0B\u89D2\u7684\u683C\u5B50\u88E1\uFF08\u6700\u591A3\u500B\uFF09\u3002\n\u62CD\u8CE3\u671F\u9593\uFF0C\u7121\u8AD6\u662F\u8CE3\u5BB6\u9084\u662F\u89C0\u6230\u4E2D\uFF0C\n\u90FD\u53EF\u4EE5\u9EDE\u9078\u683C\u5B50\u6216\u6309
      1\u30FB2\u30FB3 \u9375\u4F7F\u7528\uFF01"
  - key: tutorial.item.magnifier
    japanese: "\u866B\u773C\u93E1\u3092\u4F7F\u3063\u3066\u307F\u3088\u3046\uFF01\n\u51FA\u54C1\u306B\u4ED8\u3044\u3066\u3044\u308B\u52B9\u679C\u30AB\u30FC\u30C9\u3092\n\u81EA\u5206\u3060\u3051\u898B\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3088\uFF01"
    english: 'Try the magnifier!

      It lets only you see the effect cards

      attached
      to the listing!'
    chineseSimplified: "\u8BD5\u8BD5\u653E\u5927\u955C\u5427\uFF01\n\u53EF\u4EE5\u53EA\u8BA9\u81EA\u5DF1\u770B\u5230\n\u62CD\u54C1\u4E0A\u9644\u52A0\u7684\u6548\u679C\u5361\uFF01"
    chineseTraditional: "\u8A66\u8A66\u653E\u5927\u93E1\u5427\uFF01\n\u53EF\u4EE5\u53EA\u8B93\u81EA\u5DF1\u770B\u5230\n\u62CD\u54C1\u4E0A\u9644\u52A0\u7684\u6548\u679C\u5361\uFF01"
  - key: tutorial.item.plug
    japanese: "\u96FB\u6C17\u30D7\u30E9\u30B0\u3092\u4F7F\u3063\u3066\u307F\u3088\u3046\uFF01\n\u9078\u3093\u3060\u4EBA\u306B\u30B7\u30FC\u30EB\u30C9\u30921\u679A\u8CBC\u308C\u308B\u3088\uFF01"
    english: 'Try the power plug!

      It gives one shield to the player you choose!'
    chineseSimplified: "\u8BD5\u8BD5\u7535\u63D2\u5934\u5427\uFF01\n\u53EF\u4EE5\u7ED9\u9009\u4E2D\u7684\u4EBA\u8D34\u4E0A1\u5F20\u62A4\u76FE\uFF01"
    chineseTraditional: "\u8A66\u8A66\u96FB\u63D2\u982D\u5427\uFF01\n\u53EF\u4EE5\u7D66\u9078\u4E2D\u7684\u4EBA\u8CBC\u4E0A1\u5F35\u8B77\u76FE\uFF01"
  - key: tutorial.item.plug_pick
    japanese: "\u30B7\u30FC\u30EB\u30C9\u3092\u4ED8\u3051\u308B\u4EBA\u3092\u9078\u307C\u3046\uFF01\n\u81EA\u5206\u306B\u4ED8\u3051\u308B\u306A\u3089\u4E0B\u306E\u300C\u81EA\u5206\u300D\u3092\u62BC\u3057\u3066\u306D\uFF08\u53F3\u30AF\u30EA\u30C3\u30AF\u3067\u3084\u3081\u308B\uFF09"
    english: 'Choose who gets the shield!

      To shield yourself, press the button
      at the bottom (right-click to cancel).'
    chineseSimplified: "\u9009\u62E9\u8981\u8D34\u62A4\u76FE\u7684\u4EBA\u5427\uFF01\n\u8981\u7ED9\u81EA\u5DF1\u8D34\u7684\u8BDD\uFF0C\u8BF7\u6309\u4E0B\u65B9\u7684\u300C\u81EA\u5DF1\u300D\uFF08\u53F3\u952E\u53D6\u6D88\uFF09"
    chineseTraditional: "\u9078\u64C7\u8981\u8CBC\u8B77\u76FE\u7684\u4EBA\u5427\uFF01\n\u8981\u7D66\u81EA\u5DF1\u8CBC\u7684\u8A71\uFF0C\u8ACB\u6309\u4E0B\u65B9\u7684\u300C\u81EA\u5DF1\u300D\uFF08\u53F3\u9375\u53D6\u6D88\uFF09"
  - key: tutorial.item.shield
    japanese: "\u30B7\u30FC\u30EB\u30C9\u304C\u8CBC\u3089\u308C\u305F\uFF01\n\u898B\u9001\u308A\u6A29\u3092\u4F7F\u3046\u3068\u304D\u3001\u4EE3\u308F\u308A\u306B\u30B7\u30FC\u30EB\u30C9\u304C\u4F7F\u308F\u308C\u308B\u3088\u3002\n\u3053\u306E\u30BF\u30FC\u30F3\u306E\u843D\u672D\u304C\u7D42\u308F\u308B\u3068\u6D88\u3048\u308B\u3088\u3002\n\u6B8B\u3063\u3066\u3044\u308B\u9593\u306F\u3001\u304B\u304B\u3063\u3066\u3044\u308B\u52B9\u679C\u306E\u4E00\u89A7\u306B\u51FA\u3066\u3044\u308B\u3088\uFF01"
    english: 'Shield up!

      When you would use a pass ticket, the shield is used
      instead.

      It disappears when this turn''s auction ends.

      While
      it lasts, it is shown in your active effects list!'
    chineseSimplified: "\u8D34\u4E0A\u62A4\u76FE\u4E86\uFF01\n\u8981\u4F7F\u7528\u5F03\u6743\u5238\u65F6\uFF0C\u4F1A\u6539\u4E3A\u4F7F\u7528\u62A4\u76FE\u3002\n\u672C\u56DE\u5408\u7684\u62CD\u5356\u7ED3\u675F\u540E\u62A4\u76FE\u6D88\u5931\u3002\n\u62A4\u76FE\u5B58\u5728\u671F\u95F4\uFF0C\u4F1A\u663E\u793A\u5728\u751F\u6548\u4E2D\u7684\u6548\u679C\u5217\u8868\u91CC\uFF01"
    chineseTraditional: "\u8CBC\u4E0A\u8B77\u76FE\u4E86\uFF01\n\u8981\u4F7F\u7528\u68C4\u6B0A\u5238\u6642\uFF0C\u6703\u6539\u70BA\u4F7F\u7528\u8B77\u76FE\u3002\n\u672C\u56DE\u5408\u7684\u62CD\u8CE3\u7D50\u675F\u5F8C\u8B77\u76FE\u6D88\u5931\u3002\n\u8B77\u76FE\u5B58\u5728\u671F\u9593\uFF0C\u6703\u986F\u793A\u5728\u751F\u6548\u4E2D\u7684\u6548\u679C\u5217\u8868\u88E1\uFF01"
  - key: tutorial.item.remote
    japanese: "\u30EA\u30E2\u30B3\u30F3\u3092\u4F7F\u3063\u3066\u307F\u3088\u3046\uFF01\n\u9078\u3093\u3060\u76F8\u624B\u3092\u30DE\u30D2\u3055\u305B\u3066\u3001\n\u305D\u306E\u4EBA\u306E\u6B21\u306E\u51FA\u54C1\u30BF\u30FC\u30F3\u3092\u98DB\u3070\u305B\u308B\u3088\uFF01"
    english: 'Try the remote!

      Paralyze a player to skip

      their next
      listing turn!'
    chineseSimplified: "\u8BD5\u8BD5\u9065\u63A7\u5668\u5427\uFF01\n\u8BA9\u9009\u4E2D\u7684\u5BF9\u624B\u9EBB\u75F9\uFF0C\n\u8DF3\u8FC7\u4ED6\u7684\u4E0B\u4E00\u4E2A\u4E0A\u62CD\u56DE\u5408\uFF01"
    chineseTraditional: "\u8A66\u8A66\u9059\u63A7\u5668\u5427\uFF01\n\u8B93\u9078\u4E2D\u7684\u5C0D\u624B\u9EBB\u75FA\uFF0C\n\u8DF3\u904E\u4ED6\u7684\u4E0B\u4E00\u500B\u4E0A\u62CD\u56DE\u5408\uFF01"
  - key: tutorial.item.remote_pick
    japanese: "\u30DE\u30D2\u3055\u305B\u308B\u76F8\u624B\u3092\u9078\u307C\u3046\uFF01\n\u982D\u306E\u4E0A\u306E\u540D\u524D\u3092\u62BC\u3057\u3066\u306D\uFF08\u53F3\u30AF\u30EA\u30C3\u30AF\u3067\u3084\u3081\u308B\uFF09"
    english: 'Choose who to paralyze!

      Click a name above their head (right-click
      to cancel).'
    chineseSimplified: "\u9009\u62E9\u8981\u9EBB\u75F9\u7684\u5BF9\u624B\u5427\uFF01\n\u70B9\u51FB\u5934\u4E0A\u7684\u540D\u5B57\uFF08\u53F3\u952E\u53D6\u6D88\uFF09"
    chineseTraditional: "\u9078\u64C7\u8981\u9EBB\u75FA\u7684\u5C0D\u624B\u5427\uFF01\n\u9EDE\u9078\u982D\u4E0A\u7684\u540D\u5B57\uFF08\u53F3\u9375\u53D6\u6D88\uFF09"
  - key: tutorial.item.paralysis
    japanese: "\u30DE\u30D2\u3055\u305B\u305F\uFF01\n\u30DE\u30D2\u3057\u305F\u4EBA\u306F\u9752\u767D\u3044\u96FB\u6C17\u306B\u5305\u307E\u308C\u3066\u3001\n\u6B21\u306E\u51FA\u54C1\u30BF\u30FC\u30F3\u304C\u98DB\u3070\u3055\u308C\u308B\u3088\uFF01"
    english: 'Paralyzed!

      They are wrapped in blue-white sparks,

      and
      their next listing turn is skipped!'
    chineseSimplified: "\u9EBB\u75F9\u6210\u529F\uFF01\n\u9EBB\u75F9\u7684\u4EBA\u4F1A\u88AB\u9752\u767D\u8272\u7684\u7535\u6D41\u5305\u56F4\uFF0C\n\u4E0B\u4E00\u4E2A\u4E0A\u62CD\u56DE\u5408\u4F1A\u88AB\u8DF3\u8FC7\uFF01"
    chineseTraditional: "\u9EBB\u75FA\u6210\u529F\uFF01\n\u9EBB\u75FA\u7684\u4EBA\u6703\u88AB\u9752\u767D\u8272\u7684\u96FB\u6D41\u5305\u570D\uFF0C\n\u4E0B\u4E00\u500B\u4E0A\u62CD\u56DE\u5408\u6703\u88AB\u8DF3\u904E\uFF01"
