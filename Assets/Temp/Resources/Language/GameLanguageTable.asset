    english: "Round {0} \u2014 turn of {1}"
    chineseSimplified: "\u7B2C {0} \u8F6E\u3000{1} \u7684\u56DE\u5408"
    chineseTraditional: "\u7B2C {0} \u8F2A\u3000{1} \u7684\u56DE\u5408"
