    chineseTraditional: "\u4E2D"
  - key: game.rarity.high
    japanese: "\u9AD8"
    english: High
    chineseSimplified: "\u9AD8"
    chineseTraditional: "\u9AD8"
  - key: game.prompt.spectating
    japanese: "\u30AA\u30FC\u30AF\u30B7\u30E7\u30F3\u3092\u89B3\u6226\u4E2D"
    english: Spectating the auction
    chineseSimplified: "\u6B63\u5728\u89C2\u6218\u62CD\u5356"
    chineseTraditional: "\u6B63\u5728\u89C0\u6230\u62CD\u8CE3"
  - key: game.prompt.choose_goods
    japanese: "\u624B\u672D\u3092\u5E83\u3052\u3066\u3001\u51FA\u54C1\u3059\u308B\u30B0\u30C3\u30BA\u30AB\u30FC\u30C9\u3092\u9078\u3093\u3067\u304F\u3060\u3055\u3044"
    english: Spread your hand and choose a goods card to list
    chineseSimplified: "\u5C55\u5F00\u624B\u724C\uFF0C\u9009\u62E9\u8981\u4E0A\u62CD\u7684\u5546\u54C1\u5361"
    chineseTraditional: "\u5C55\u958B\u624B\u724C\uFF0C\u9078\u64C7\u8981\u4E0A\u62CD\u7684\u5546\u54C1\u5361"
  - key: game.prompt.attach_buff
    japanese: "{0}\uFF08\u6700\u4F4E {1}\uFF09\u3092\u51FA\u54C1\u3057\u307E\u3059\u3002\u30D0\u30D5\u30C7\u30D0\u30D5\u30AB\u30FC\u30C9\u3092\u4F7F\u3046\u306A\u3089\u30AF\u30EA\u30C3\u30AF\u3001\u6C7A\u307E\u3063\u305F\u3089\u78BA\u5B9A"
    english: Listing {0} (min {1}). Click to attach a buff/debuff, then confirm
    chineseSimplified: "\u4E0A\u62CD {0}\uFF08\u5E95\u4EF7 {1}\uFF09\u3002\u8981\u9644\u52A0\u589E\u76CA/\u51CF\u76CA\u5361\u5C31\u70B9\u51FB\uFF0C\u51B3\u5B9A\u540E\u6309\u786E\u8BA4"
    chineseTraditional: "\u4E0A\u62CD {0}\uFF08\u5E95\u50F9 {1}\uFF09\u3002\u8981\u9644\u52A0\u589E\u76CA/\u6E1B\u76CA\u5361\u5C31\u9EDE\u9078\uFF0C\u6C7A\u5B9A\u5F8C\u6309\u78BA\u8A8D"
  - key: game.prompt.choose_raise
    japanese: "{0}\uFF08\u6700\u4F4E {1}\uFF09\u3092\u51FA\u54C1\u3057\u307E\u3059\u3002\u5897\u984D\u3059\u308B\u304B\u9078\u3093\u3067\u78BA\u5B9A"
    english: Listing {0} (min {1}). Choose whether to raise, then confirm
    chineseSimplified: "\u4E0A\u62CD {0}\uFF08\u5E95\u4EF7 {1}\uFF09\u3002\u9009\u62E9\u662F\u5426\u52A0\u4EF7\u540E\u6309\u786E\u8BA4"
    chineseTraditional: "\u4E0A\u62CD {0}\uFF08\u5E95\u50F9 {1}\uFF09\u3002\u9078\u64C7\u662F\u5426\u52A0\u50F9\u5F8C\u6309\u78BA\u8A8D"
  - key: game.prompt.highest
    japanese: "\u6700\u9AD8\u984D\u3067\u3059\u3002\u3055\u3089\u306B\u91D1\u984D\u3092\u4E0A\u3052\u3066\u5165\u672D\u3059\u308B\u3053\u3068\u3082\u3067\u304D\u307E\u3059\uFF08\u6700\u9AD8\u984D\u306E\u3042\u3044\u3060\u306F\u964D\u308A\u3089\u308C\u307E\u305B\u3093\uFF09"
    english: You are the highest bidder. You can raise your bid further (you can't
      pass while you hold the highest bid)
    chineseSimplified: "\u4F60\u662F\u6700\u9AD8\u51FA\u4EF7\u8005\u3002\u4E5F\u53EF\u4EE5\u7EE7\u7EED\u52A0\u4EF7\u51FA\u4EF7\uFF08\u4F5C\u4E3A\u6700\u9AD8\u51FA\u4EF7\u8005\u65F6\u4E0D\u80FD\u653E\u5F03\uFF09"
    chineseTraditional: "\u4F60\u662F\u6700\u9AD8\u51FA\u50F9\u8005\u3002\u4E5F\u53EF\u4EE5\u7E7C\u7E8C\u52A0\u50F9\u51FA\u50F9\uFF08\u4F5C\u70BA\u6700\u9AD8\u51FA\u50F9\u8005\u6642\u4E0D\u80FD\u653E\u68C4\uFF09"
  - key: game.prompt.must_pass
    japanese: "\u30B3\u30A4\u30F3\u304C\u8DB3\u308A\u306A\u3044\u305F\u3081\u964D\u308A\u308B\u3057\u304B\u3042\u308A\u307E\u305B\u3093\uFF08\u898B\u9001\u308A\u6A29\u3092\u4F7F\u3044\u307E\u3059\uFF09"
    english: "Not enough coins \u2014 you must pass (uses a pass right)"
    chineseSimplified: "\u91D1\u5E01\u4E0D\u8DB3\uFF0C\u53EA\u80FD\u653E\u5F03\uFF08\u5C06\u4F7F\u7528\u5F03\u6743\u5238\uFF09"
    chineseTraditional: "\u91D1\u5E63\u4E0D\u8DB3\uFF0C\u53EA\u80FD\u653E\u68C4\uFF08\u5C07\u4F7F\u7528\u68C4\u6B0A\u5238\uFF09"
  - key: game.prompt.bid_or_pass
    japanese: "W/S \u304B \u2191/\u2193\uFF08\u30B3\u30F3\u30C8\u30ED\u30FC\u30E9\u30FC\u306F\u5341\u5B57\u30AD\u30FC\uFF09\u3067\u91D1\u984D\u3092\u6307\u5B9A\u3057\u3066\u5165\u672D\u3059\u308B\u304B\u3001\u964D\u308A\u308B\u304B\u3092\u9078\u3093\u3067\u304F\u3060\u3055\u3044\uFF08\u964D\u308A\u308B\u3068\u898B\u9001\u308A\u6A29\u3092\u4F7F\u3044\u307E\u3059\uFF09"
    english: "Set an amount with W/S or \u2191/\u2193 (D-pad on a controller) and
      bid, or pass (passing uses a pass)"
    chineseSimplified: "\u7528 W/S \u6216 \u2191/\u2193\uFF08\u624B\u67C4\u7528\u5341\u5B57\u952E\uFF09\u8BBE\u5B9A\u91D1\u989D\u51FA\u4EF7\uFF0C\u6216\u9009\u62E9\u653E\u5F03\uFF08\u653E\u5F03\u4F1A\u4F7F\u7528\u5F03\u6743\u5238\uFF09"
    chineseTraditional: "\u7528 W/S \u6216 \u2191/\u2193\uFF08\u624B\u67C4\u7528\u5341\u5B57\u9375\uFF09\u8A2D\u5B9A\u91D1\u984D\u51FA\u50F9\uFF0C\u6216\u9078\u64C7\u653E\u68C4\uFF08\u653E\u68C4\u6703\u4F7F\u7528\u68C4\u6B0A\u5238\uFF09"
  - key: game.auction.summary
    japanese: "\u6700\u4F4E {0} / \u6700\u9AD8\u984D {1} / \u81EA\u5206 {2} / \u6240\u6301
      {3}"
    english: Min {0} / High {1} / You {2} / Coins {3}
    chineseSimplified: "\u5E95\u4EF7 {0} / \u6700\u9AD8\u4EF7 {1} / \u4F60 {2} /
      \u6301\u6709 {3}"
    chineseTraditional: "\u5E95\u50F9 {0} / \u6700\u9AD8\u50F9 {1} / \u4F60 {2} /
      \u6301\u6709 {3}"
  - key: game.auction.pass
    japanese: "\u964D\u308A\u308B"
    english: Pass
    chineseSimplified: "\u653E\u5F03"
    chineseTraditional: "\u653E\u68C4"
