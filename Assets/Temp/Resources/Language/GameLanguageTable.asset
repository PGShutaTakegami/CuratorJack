    chineseTraditional: "FINAL BATTLE\uFF1A\u6BD4\u5E95\u50F9\u591A\u51FA\u50F9\u62CD\u5F97\u7684\u90E8\u5206\uFF0C\u53EF\u4EE5\u524A\u6E1B\u5C0D\u624B\u7684\u91D1\u5E63\u3002\u8ACB\u8A2D\u5B9A\u91D1\u984D\u51FA\u50F9\uFF0C\u6216\u9078\u64C7\u653E\u68C4"
