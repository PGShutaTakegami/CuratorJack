    chineseSimplified: "\u8FD4\u56DE"
    chineseTraditional: "\u8FD4\u56DE"
  - key: achievement.tutorial_clear.name
    japanese: "\u898B\u7FD2\u3044\u30AD\u30E5\u30EC\u30FC\u30BF\u30FC"
