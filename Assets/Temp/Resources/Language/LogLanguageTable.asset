  entries:
  - key: log.tutorial.no_first_goods
    japanese: "\u30BF\u30FC\u30F3 1 \u3067\u51FA\u54C1\u3059\u308B\u30AB\u30FC\u30C9\u304C\u624B\u672D\u306B\u3042\u308A\u307E\u305B\u3093"
    english: The card to list on turn 1 is not in hand
    chineseSimplified: "\u624B\u724C\u4E2D\u6CA1\u6709\u7B2C 1 \u56DE\u5408\u8981\u4E0A\u62CD\u7684\u5361\u724C"
