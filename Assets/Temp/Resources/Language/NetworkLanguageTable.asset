  m_Script: {fileID: 11500000, guid: ffa302fe71f764f4f8464c345ab9ca1c, type: 3}
  m_Name: NetworkLanguageTable
  m_EditorClassIdentifier: Assembly-CSharp::LanguageTable
  entries:
  - key: net.version_mismatch
    japanese: "\u30B2\u30FC\u30E0\u306E\u30D0\u30FC\u30B8\u30E7\u30F3\u304C\u9055\u3046\u305F\u3081\u5165\u308C\u307E\u305B\u3093"
    english: Can't join because the game version is different
    chineseSimplified: "\u6E38\u620F\u7248\u672C\u4E0D\u540C\uFF0C\u65E0\u6CD5\u52A0\u5165"
    chineseTraditional: "\u904A\u6232\u7248\u672C\u4E0D\u540C\uFF0C\u7121\u6CD5\u52A0\u5165"
  - key: net.room_start_failed
    japanese: "\u90E8\u5C4B\u3092\u958B\u59CB\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F:
      {0}\uFF08{1}:{2}\uFF09"
    english: 'Could not start the room: {0} ({1}:{2})'
    chineseSimplified: "\u65E0\u6CD5\u5F00\u542F\u623F\u95F4\uFF1A{0}\uFF08{1}:{2}\uFF09"
    chineseTraditional: "\u7121\u6CD5\u958B\u555F\u623F\u9593\uFF1A{0}\uFF08{1}:{2}\uFF09"
  - key: net.room_join_failed
    japanese: "\u90E8\u5C4B\u306B\u5165\u308C\u307E\u305B\u3093\u3067\u3057\u305F:
      {0}"
    english: 'Could not join the room: {0}'
    chineseSimplified: "\u65E0\u6CD5\u8FDB\u5165\u623F\u95F4\uFF1A{0}"
    chineseTraditional: "\u7121\u6CD5\u9032\u5165\u623F\u9593\uFF1A{0}"
  - key: net.rematch_join_failed
    japanese: "\u30EA\u30C8\u30E9\u30A4\u5F8C\u306E\u90E8\u5C4B\u306B\u5165\u308C\u307E\u305B\u3093\u3067\u3057\u305F:
      {0}"
    english: 'Could not join the rematch room: {0}'
    chineseSimplified: "\u65E0\u6CD5\u8FDB\u5165\u91CD\u5F00\u540E\u7684\u623F\u95F4\uFF1A{0}"
    chineseTraditional: "\u7121\u6CD5\u9032\u5165\u91CD\u958B\u5F8C\u7684\u623F\u9593\uFF1A{0}"
  - key: net.room_unavailable
    japanese: "\u90E8\u5C4B\u3092\u7528\u610F\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F"
    english: Could not prepare a room
    chineseSimplified: "\u65E0\u6CD5\u51C6\u5907\u623F\u95F4"
    chineseTraditional: "\u7121\u6CD5\u6E96\u5099\u623F\u9593"
  - key: net.rejected_full
    japanese: "\u53C2\u52A0\u3092\u62D2\u5426\u3055\u308C\u307E\u3057\u305F: \u6E80\u54E1\u3067\u3059\uFF08\u6700\u5927
      {0} \u4EBA\uFF09"
    english: 'Join refused: the room is full (max {0} players)'
    chineseSimplified: "\u52A0\u5165\u88AB\u62D2\u7EDD\uFF1A\u623F\u95F4\u5DF2\u6EE1\uFF08\u6700\u591A
      {0} \u4EBA\uFF09"
    chineseTraditional: "\u52A0\u5165\u88AB\u62D2\u7D55\uFF1A\u623F\u9593\u5DF2\u6EFF\uFF08\u6700\u591A
      {0} \u4EBA\uFF09"
  - key: net.rejected
    japanese: "\u53C2\u52A0\u3092\u62D2\u5426\u3055\u308C\u307E\u3057\u305F: {0}"
    english: 'Join refused: {0}'
    chineseSimplified: "\u52A0\u5165\u88AB\u62D2\u7EDD\uFF1A{0}"
    chineseTraditional: "\u52A0\u5165\u88AB\u62D2\u7D55\uFF1A{0}"
  - key: net.local_session_failed
    japanese: "Local \u30BB\u30C3\u30B7\u30E7\u30F3\u3092\u958B\u59CB\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F\uFF08{0}:{1}\uFF09"
    english: Could not start the Local session ({0}:{1})
    chineseSimplified: "\u65E0\u6CD5\u5F00\u542F Local \u4F1A\u8BDD\uFF08{0}:{1}\uFF09"
    chineseTraditional: "\u7121\u6CD5\u958B\u555F Local \u6703\u8A71\uFF08{0}:{1}\uFF09"
  - key: net.no_local_player
    japanese: "\u81EA\u5206\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u7528\u610F\u3055\u308C\u306A\u304B\u3063\u305F\u305F\u3081\u3001\u30ED\u30D3\u30FC\u3078\u623B\u308A\u307E\u3059"
    english: Your player was not created, returning to the lobby
    chineseSimplified: "\u672A\u80FD\u51C6\u5907\u4F60\u7684\u73A9\u5BB6\uFF0C\u8FD4\u56DE\u5927\u5385"
    chineseTraditional: "\u672A\u80FD\u6E96\u5099\u4F60\u7684\u73A9\u5BB6\uFF0C\u8FD4\u56DE\u5927\u5EF3"
  - key: net.kicked
    japanese: "\u90E8\u5C4B\u4E3B\u306B\u30AD\u30C3\u30AF\u3055\u308C\u305F\u305F\u3081\u3001\u30ED\u30D3\u30FC\u3078\u623B\u308A\u307E\u3059"
    english: You were kicked by the host, returning to the lobby
    chineseSimplified: "\u4F60\u88AB\u623F\u4E3B\u8E22\u51FA\uFF0C\u8FD4\u56DE\u5927\u5385"
    chineseTraditional: "\u4F60\u88AB\u623F\u4E3B\u8E22\u51FA\uFF0C\u8FD4\u56DE\u5927\u5EF3"
  - key: net.host_takeover_failed
    japanese: "\u30DB\u30B9\u30C8\u3092\u5F15\u304D\u7D99\u3052\u307E\u305B\u3093\u3067\u3057\u305F:
      {0}"
    english: 'Could not take over as host: {0}'
    chineseSimplified: "\u65E0\u6CD5\u63A5\u4EFB\u4E3B\u673A\uFF1A{0}"
    chineseTraditional: "\u7121\u6CD5\u63A5\u4EFB\u4E3B\u6A5F\uFF1A{0}"
  - key: net.online_requires_lobby
    japanese: "OnlineNet \u3067\u306F\u30ED\u30D3\u30FC\u3067\u90E8\u5C4B\u3092\u9078\u3093\u3067\u304B\u3089
      GameScene \u306B\u5165\u3063\u3066\u304F\u3060\u3055\u3044"
    english: In OnlineNet, choose a room in the lobby before entering GameScene
    chineseSimplified: "\u5728 OnlineNet \u4E2D\uFF0C\u8BF7\u5148\u5728\u5927\u5385\u9009\u62E9\u623F\u95F4\u518D\u8FDB\u5165
      GameScene"
    chineseTraditional: "\u5728 OnlineNet \u4E2D\uFF0C\u8ACB\u5148\u5728\u5927\u5EF3\u9078\u64C7\u623F\u9593\u518D\u9032\u5165
      GameScene"
  - key: net.action.join_rematch
    japanese: "\u30EA\u30C8\u30E9\u30A4\u5F8C\u306E\u90E8\u5C4B\u306B\u5165\u5BA4"
    english: join the rematch room
    chineseSimplified: "\u8FDB\u5165\u91CD\u5F00\u540E\u7684\u623F\u95F4"
    chineseTraditional: "\u9032\u5165\u91CD\u958B\u5F8C\u7684\u623F\u9593"
  - key: net.action.create
    japanese: "\u90E8\u5C4B\u3092\u4F5C\u6210"
    english: create a room
    chineseSimplified: "\u521B\u5EFA\u623F\u95F4"
    chineseTraditional: "\u5EFA\u7ACB\u623F\u9593"
  - key: net.action.join
    japanese: "\u90E8\u5C4B\u306B\u5165\u5BA4"
    english: join the room
    chineseSimplified: "\u8FDB\u5165\u623F\u95F4"
    chineseTraditional: "\u9032\u5165\u623F\u9593"
  - key: net.action_failed
    japanese: "{0}\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F: {1}"
    english: 'Could not {0}: {1}'
    chineseSimplified: "\u65E0\u6CD5{0}\uFF1A{1}"
    chineseTraditional: "\u7121\u6CD5{0}\uFF1A{1}"
  - key: net.room_host_start_failed
    japanese: "\u90E8\u5C4B\u306E\u30DB\u30B9\u30C8\u3092\u958B\u59CB\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F"
    english: Could not start hosting the room
    chineseSimplified: "\u65E0\u6CD5\u5F00\u59CB\u4F5C\u4E3A\u623F\u95F4\u4E3B\u673A"
    chineseTraditional: "\u7121\u6CD5\u958B\u59CB\u4F5C\u70BA\u623F\u9593\u4E3B\u6A5F"
  - key: net.game_started
    japanese: "\u30B2\u30FC\u30E0\u304C\u59CB\u307E\u3063\u3066\u3044\u307E\u3059"
    english: The game has already started
    chineseSimplified: "\u6E38\u620F\u5DF2\u7ECF\u5F00\u59CB\u4E86"
    chineseTraditional: "\u904A\u6232\u5DF2\u7D93\u958B\u59CB\u4E86"
  - key: net.kicked_room
    japanese: "\u30AD\u30C3\u30AF\u3055\u308C\u305F\u90E8\u5C4B\u306B\u306F\u5165\u308C\u307E\u305B\u3093"
    english: You can't join a room you were kicked from
    chineseSimplified: "\u65E0\u6CD5\u8FDB\u5165\u4F60\u88AB\u8E22\u51FA\u7684\u623F\u95F4"
    chineseTraditional: "\u7121\u6CD5\u9032\u5165\u4F60\u88AB\u8E22\u51FA\u7684\u623F\u9593"
  - key: net.host_connect_failed
    japanese: "\u30DB\u30B9\u30C8\u306B\u63A5\u7D9A\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F"
    english: Could not connect to the host
    chineseSimplified: "\u65E0\u6CD5\u8FDE\u63A5\u5230\u4E3B\u673A"
    chineseTraditional: "\u7121\u6CD5\u9023\u7DDA\u5230\u4E3B\u6A5F"
  - key: net.host_disconnected
    japanese: "\u30DB\u30B9\u30C8\u3068\u306E\u63A5\u7D9A\u304C\u5207\u308C\u305F\u305F\u3081\u3001\u30ED\u30D3\u30FC\u3078\u623B\u308A\u307E\u3059"
    english: Lost connection to the host, returning to the lobby
    chineseSimplified: "\u4E0E\u4E3B\u673A\u7684\u8FDE\u63A5\u5DF2\u65AD\u5F00\uFF0C\u8FD4\u56DE\u5927\u5385"
    chineseTraditional: "\u8207\u4E3B\u6A5F\u7684\u9023\u7DDA\u5DF2\u65B7\u958B\uFF0C\u8FD4\u56DE\u5927\u5EF3"
  - key: net.migration_failed
    japanese: "\u30DB\u30B9\u30C8\u3092\u5F15\u304D\u7D99\u3052\u306A\u304B\u3063\u305F\u305F\u3081\u3001\u30ED\u30D3\u30FC\u3078\u623B\u308A\u307E\u3059"
    english: Could not take over as host, returning to the lobby
    chineseSimplified: "\u65E0\u6CD5\u63A5\u4EFB\u4E3B\u673A\uFF0C\u8FD4\u56DE\u5927\u5385"
    chineseTraditional: "\u7121\u6CD5\u63A5\u4EFB\u4E3B\u6A5F\uFF0C\u8FD4\u56DE\u5927\u5EF3"
